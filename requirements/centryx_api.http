#####################################################################################################################
#                                   Authentication and User Management Endpoints                                   #
#####################################################################################################################

### 1) Login as Admin user
POST {{HOST}}/auth/login/
Content-Type: application/json

{
  "username": "{{ADMIN_USERNAME}}",
  "password": "{{ADMIN_PASSWORD}}"
}


### 2) Register New User
### Expected: 201 Created with user details
POST {{HOST}}/auth/registration/
Content-Type: application/json

{
  "username": "testudser",
  "email": "lenomadeleineantoine@gmail.com",
  "password1": "Testpass123!",
  "password2": "Testpass123!",
  "first_name": "Antoine",
  "last_name": "Leno",
  "phone_number": "+60123456789"
}


### 2a) Verify Email (after registration)
### Expected: 200 OK on success
POST {{HOST}}/auth/registration/verify-email/
Content-Type: application/json

{
  "key": "Mg:1vIUkw:QKZU59qdE_RdEXVMGx7vBkn_kharpX27c2p2Sc8vwtU"
}


### 2b) login to get tokens
### Expected: 200 OK with access and refresh tokens
POST {{HOST}}/auth/login/
Content-Type: application/json

{
  "username": "testudser",
  "password": "Testpass123!"
}

### 2c) Get access token from refresh token
### Expected: 200 OK with new access token
POST {{HOST}}/auth/token/refresh/
Content-Type: application/json

{
  "refresh": "{{refresh_token}}"
}

### 2d) Verify Token
### Expected: 200 OK if token is valid
POST {{HOST}}/auth/token/verify/
Content-Type: application/json

{
  "token": "{{access_token}}"
}


### 3) Attempt Registration with Existing Username
### Expected: 400 Bad Request with error message about username taken
POST {{HOST}}/auth/registration/
Content-Type: application/json

{
  "username": "centryxadmin",
  "email": "antoine.leno@student.aiu.edu.my",
  "password1": "Testpass123!",
  "password2": "Testpass123!",
  "first_name": "Antoine",
  "last_name": "Leno",
  "phone_number": "+60123456789"
}


### 4) Get current user informations
### Expected: 200 OK with admin user details
GET {{HOST}}/auth/user/
Accept: application/json
Authorization: Bearer {{access_token}}


### 5) Update current user informations excluding profile image
### Expected: 200 OK with updated user details 
PATCH {{HOST}}/auth/user/
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "first_name": "Admin",
  "last_name": "User",
  "phone_number": "+60199887766"
}

### 6) Update current user profile image only (multipart)
### Expected: 200 OK with updated user details including profile image URL
PATCH {{HOST}}/auth/user/
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="profile_image"; filename="camera.png"
Content-Type: image/png

< ./camera.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--


### 7) Update current user informations including profile image (multipart)
PATCH {{HOST}}/auth/user/
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="first_name"

Antoine
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="last_name"

Leno
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="phone_number"

+60111222333
------WebKitFormBoundary7MA4YWxkTrZu0gW--



### 7) Change Password (Authenticated)
### Expected: 200 OK on success

POST {{HOST}}/auth/password/change/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "old_password": "Testpass123!",
  "new_password1": "Newpass456!",
  "new_password2": "Newpass456!"
}


### 8) Login with new password after change
### Expected: 200 OK with new access and refresh tokens
POST {{HOST}}/auth/login/
Content-Type: application/json

{
  "username": "testudser",
  "password": "Newpass456!"
}


### 9) Request Password Reset (Email)
### Expected: 200 OK (email with reset link/token is sent)
POST {{HOST}}/auth/password/reset/
Content-Type: application/json

{
  "email": "lenomadeleineantoine@gmail.com"
}


### 10) Confirm Password Reset (from email)
### Expected: 200 OK (password successfully changed)

POST {{HOST}}/auth/password/reset/confirm/
Content-Type: application/json

{
  "uid": "2",
  "token": "cz26ma-d241c1da9db2ad7e9d926deb3cce3698",
  "new_password1": "ResetPass123!",
  "new_password2": "ResetPass123!"
}


### 11) Login with new password after reset
### Expected: 200 OK with new access and refresh tokens
POST {{HOST}}/auth/login/
Content-Type: application/json

{
  "username": "testudser",
  "password": "ResetPass123!"
}


### 12) Activate 2FA for current user (Step 1: Request activation)
### Expected: 200 OK with confirmation message
POST http://127.0.0.1:8000/auth/mfa/app/activate/
Authorization: Bearer {{access_token}}
Content-Type: application/json


### 13) Confirm 2FA activation with code from authenticator app
### Expected: 200 OK with backup codes (2FA is now active)
POST {{HOST}}/auth/mfa/app/activate/confirm/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "code": "590608"
}


### 14) Deactivate 2FA
### Expected: 200 OK (2FA is now disabled)
### Must provide valid TOTP code from antoine.py to deactivate
POST {{HOST}}/auth/mfa/app/deactivate/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "code": "590608"
}


### 15) Logout user (invalidate refresh token)
### Expected: 200 OK on success
POST {{HOST}}/auth/logout/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "refresh": "{{refresh_token}}"
}


### 16) List all users (Admin only)
### Expected: 200 OK with list of all users
GET {{HOST}}/integration/users/
Authorization: Bearer {{access_token}}


### 17) Delete a user by ID (Admin only)
### Expected: 204 No Content on success
DELETE {{HOST}}/integration/users/2/
Authorization: Bearer {{access_token}}


#####################################################################################################################
#                                   Authentication and User Management Endpoints end                               #
#####################################################################################################################





#####################################################################################################################
#                                   CCTV Management Endpoints                                                     #
#####################################################################################################################

                  ########################################################################
                  #             General CCTV Management Endpoints                       #
                  ########################################################################

### 1) Get all CCTV brands
### Expected: 200 OK with list of brands
GET {{HOST}}/cctv/get_brands/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}


### 2) Get all models for a Dahua brand
### Expected: 200 OK with list of models
GET {{HOST}}/cctv/get_models/Dahua/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}


### 3) Get Camera Statistics (total, online, offline counts)
### Expected: 200 OK with camera statistics
GET {{HOST}}/cctv/cameras/statistics/
Authorization: Bearer {{access_token}}


### 4) Get Recording Playback URLs for Specific Devices
### Expected: 200 OK with dictionary of location: playback_url
POST {{HOST}}/cctv/cameras/recording_urls/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "devices": [
        {
            "brand": "Dahua",
            "identifier": "AF051B9PAG00225",
            "location": "Main Entrance",
            "begin_time": "2025-11-11 00:00:00",
            "end_time": "2025-11-11 23:59:59"
        },
        {
            "brand": "Hikvision",
            "identifier": "HIK123456",
            "location": "Parking Lot",
            "start_time": "2025-11-12T10:00:00",
            "stop_time": "2025-11-12T11:00:00"
        }
    ]
}


### 5) Get Live URLs for all Devices
### Expected: 200 OK with dictionary of device_id: live_url
POST {{HOST}}/cctv/cameras/live_urls/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "devices": [
        {"brand": "Dahua", "identifier": "AF051B9PAG00225", "location": "Main Entrance"},
        {"brand": "Hikvision", "identifier": "HIK123456", "location": "Parking Lot"}
    ]
}


### 6) Get Camera Details (name, brand, model, location)
### Expected: 200 OK with list of cameras
GET {{HOST}}/cctv/cameras/
Authorization: Bearer {{access_token}}


### 7) Get Cameras with Live URLs (identifier, name, location, brand, live_url)
### Expected: 200 OK with list of cameras and their live streaming URLs
GET {{HOST}}/cctv/cameras/monitoring/
Authorization: Bearer {{access_token}}


### 8 ) Get device online/offline status for one camera (Dahua)
### Expected: 200 OK with online/offline status of the device
GET {{HOST}}/cctv/get_device_status/?brand=Dahua&identifier=AF051B9PAG00225 HTTP/1.1
Authorization: Bearer {{access_token}}

### 9 ) Get device online/offline status for one camera (Hikvision)
### Expected: 200 OK with online/offline status of the device
GET {{HOST}}/cctv/get_device_status/?brand=Hikvision&identifier=HIK123456 HTTP/1.1
Authorization: Bearer {{access_token}}



                  ########################################################################
                  #             Dahua CCTV Device Management Endpoints                  #
                  ########################################################################

### 1) Add a new Dahua CCTV device with unexisting model
### Expected: 200 OK with device addition status
POST {{HOST}}/cctv/add_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "brand": "Dahua",
    "model_name": "DH-H3B",
    "identifier": "AF051B9PAG00225",
    "location": "Main Gate - Entrance",
    "name": "Entrance Camera",
    "username": "admin",
    "dev_password": "L2714ECF",
    "category_code": "IPC"
}


### 2) Delete a Dahua CCTV device
### Expected: 204 No Content on success
POST {{HOST}}/cctv/delete_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "identifier": "AF051B9PAG00225",
    "brand": "Dahua"
}


### 3) Get Live Stream of a Dahua CCTV Camera
### Expected: 200 OK with stream URL and expiry time
GET {{HOST}}/cctv/get_stream_url/?identifier=AF051B9PAG00225&brand=Dahua HTTP/1.1
Authorization: Bearer {{access_token}}

### 4) Get Recording url of a Dahua CCTV Camera
### Expected: 200 OK with stream URL and expiry time
GET {{HOST}}/cctv/get_stream_url/?identifier=AF051B9PAG00225&brand=Dahua&begin_time=2025-11-11%2000:00:00&end_time=2025-11-11%2023:59:59&business_type=playback HTTP/1.1
Authorization: Bearer {{access_token}}


                  ########################################################################
                  #             Hikvision CCTV Device Management Endpoints              #
                  ########################################################################


### 1) Add a new CCTV device from Hikvision brand
### Expected: 200 OK with device addition status
POST {{HOST}}/cctv/add_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "brand": "Hikvision",
    "model_name": "Hikvision_XVR_4104",
    "ezviz_serial_no": "HIKVISION123457",
    "location": "Backyard - Garden",
    "name": "Garden Camera",
    "ezviz_verify_code": "admin123"
}


### 2) Delete a Hikvision CCTV device
### Expected: 204 No Content on success
POST {{HOST}}/cctv/delete_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "identifier": "dddddd",
    "brand": "Hikvision"
}

### 3) Get Live Stream of a Hikvision CCTV Camera
### Expected: 200 OK with stream URL and expiry time
GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Hikvision&type=1 HTTP/1.1
Authorization: Bearer {{access_token}}


### 4) Get Recording url of a Hikvision CCTV Camera
### Expected: 200 OK with stream URL and expiry time
GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Hikvision&type=2&start_time=2025-10-29T08:00:00&stop_time=2025-10-29T10:00:00 HTTP/1.1
Authorization: Bearer {{access_token}}


