#*****************************Authentication and User Management Endpoints********************************************


### 1) Login as admin user/ obtain JWT via Djoser JWT create endpoint
### Expected: 200 OK with access and refresh tokens

POST {{HOST}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
	"username": "{{ADMIN_USERNAME}}",
	"password": "{{ADMIN_PASSWORD}}"
}


###2) Signup (user registration)
### Expected: 201 Created with user details (no token)

POST {{HOST}}/auth/users/ HTTP/1.1
Content-Type: application/json

{
	"username": "testuser",
	"email": "lenoantoine11@gmail.com",
	"password": "Testpass123!",
	"re_password": "Testpass123!"
}


### 2) Login as normal user without activating the account
### Expected: 200 OK with access and refresh tokens

POST {{HOST}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
	"username": "testuser",
	"password": "Testpass123!"
}


### 2) Activate the newly created account
### Expected: 204 No Content on success (user becomes active)

POST {{HOST}}/auth/users/activation/ HTTP/1.1
Content-Type: application/json

{
	"uid": "Mw",
	"token": "cxlyli-65e5ea962f1c2be78f1a79234590751b"
}


### 3) Login as normal user after activating the account
### Expected: 200 OK with access and refresh tokens
POST {{HOST}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
		"username": "testuser",
		"password": "Testpass123!"
}

### 4) Get a new access token using the Refresh JWT
### Expected: 200 OK with a new access token

POST {{HOST}}/auth/jwt/refresh/ HTTP/1.1
Content-Type: application/json

{
	"refresh": "{{refresh_token}}"
}

### 5) Get current user information
### Expected: 200 OK with user details (requires Authorization header)

GET {{HOST}}/auth/users/me/ HTTP/1.1
Accept: application/json
Authorization: Bearer {{access_token}}


### 6) Change password (authenticated)
### Expected: 204 No Content on success

POST {{HOST}}/auth/users/set_password/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
	"current_password": "Testpass123!",
	"new_password": "Newpass456!"
}

### 7) Update user information
### Expected: 200 OK with updated user details

PATCH {{HOST}}/auth/users/me/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "email": "newemail@example.com",
  "first_name": "Antoine",
  "last_name": "Lambert"
}


### 7) Forgot password (request password reset email)
### Expected: 204 No Content (email with reset link/token is sent)

POST {{HOST}}/auth/users/reset_password/ HTTP/1.1
Content-Type: application/json

{
	"email": "lenoantoine11@gmail.com"
}


### 8) Example using token from email
### Expected: 204 No Content (password successfully changed)

POST {{HOST}}/auth/users/reset_password_confirm/ HTTP/1.1
Content-Type: application/json

{
    "uid": "Mw",
    "token": "cxlytv-97e891a6da661b1a68fe763af16ece08",
    "new_password": "Newpass456!"
}

### 9) Final: Login with updated password (bottom)
### Expected: 200 OK with access and refresh tokens

POST {{HOST}}/auth/jwt/create/ HTTP/1.1
Content-Type: application/json

{
	"username": "testuser",
	"password": "Newpass456!"
}


#*****************************Multi-Factor Authentication (Django Trench)********************************************

### 1) Activate MFA using App (Google Authenticator)
### Expected: 200 OK → returns secret key / QR code
POST {{HOST}}/auth/app/activate/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

### 2) Confirm activation (enter 6-digit code from authenticator app)
### Expected: 204 No Content = activation successful
POST {{HOST}}/auth/app/activate/confirm/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "code": "123456"
}


### 3) Login first step (username + password → MFA challenge)
POST {{HOST}}/auth/login/ HTTP/1.1
Content-Type: application/json

{
  "username": "testuser",
  "password": "Newpass456!"
}

### 4) Login second step (submit OTP code)
POST {{HOST}}/auth/login/code/ HTTP/1.1
Content-Type: application/json

{
  "method": "app",
  "code": "123456"
}

### 5) Deactivate MFA (app)
POST {{HOST}}/auth/app/deactivate/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "code": "123456"
}

### 6) Regenerate backup codes
POST {{HOST}}/auth/app/codes/regenerate/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "code": "123456"
}


### 7) View MFA configuration
GET {{HOST}}/auth/mfa/config/ HTTP/1.1
Authorization: Bearer {{access_token}}

### 8) List user’s active methods
GET {{HOST}}/auth/mfa/user-active-methods/ HTTP/1.1
Authorization: Bearer {{access_token}}


#*****************************Authentication and User Management Endpoints end********************************************



#*****************************CCTV managment Endpoints********************************************

### 1) Get all CCTV brands
### Expected: 200 OK with list of brands

GET {{HOST}}/cctv/get_brands/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}


### 2) Get all models for a Dahua brand
### Expected: 200 OK with list of models

GET {{HOST}}/cctv/get_models/Dahua/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

### 3) Get all models for a Hikvision brand
### Expected: 200 OK with list of models

GET {{HOST}}/cctv/get_models/Hikvision/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}


### 4) Add a new Dahua CCTV device with unexisting model
### Expected: 200 OK with device addition status

POST {{HOST}}/cctv/add_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "brand": "Dahua",
    "model_name": "Dahua_XVR_4804",
    "identifier": "DAH55127456",
    "location": "Main Gate - Entrance",
    "username": "admin",
    "dev_password": "admin123"
}

### 5) Add a new Dahua CCTV device with existing model
### Expected: 200 OK with device addition status

POST {{HOST}}/cctv/add_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "brand": "Dahua",
    "model_name": "Dahua_XVR_4104",
    "identifier": "DAHUA123457",
    "location": "Main Gate - Entrance",
    "username": "admin",
    "dev_password": "admin123"
}


### 6) Add a new CCTV device from Hikvision brand
### Expected: 200 OK with device addition status
POST {{HOST}}/cctv/add_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "brand": "Hikvision",
    "model_name": "Hikvision_XVR_4104",
    "ezviz_serial_no": "HIKVISION123457",
    "location": "Backyard - Garden",
    "ezviz_verify_code": "admin123"
}


### 7) Delete a Hikvision CCTV device
### Expected: 204 No Content on success

POST {{HOST}}/cctv/delete_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "identifier": "dddddd",
    "brand": "Hikvision"
}


### 7) Delete a Dahua CCTV device
### Expected: 204 No Content on success

POST {{HOST}}/cctv/delete_device/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "identifier": "DAHUA123456",
    "brand": "Dahua"
}


### 8) Get Live Stream of a Hikvision CCTV Camera
### Expected: 200 OK with stream URL and expiry time


GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Hikvision&type=2 HTTP/1.1
Authorization: Bearer {{access_token}}

### 9) Get Recording url of a Hikvision CCTV Camera
### Expected: 200 OK with stream URL and expiry time


GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Hikvision&type=2&start_time=2025-10-29T08:00:00&stop_time=2025-10-29T10:00:00 HTTP/1.1
Authorization: Bearer {{access_token}}


### 10) Get Live Stream of a Dahua CCTV Camera
### Expected: 200 OK with stream URL and expiry time


GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Dahua HTTP/1.1
Authorization: Bearer {{access_token}}

### 9) Get Recording url of a Dahua CCTV Camera
### Expected: 200 OK with stream URL and expiry time


GET {{HOST}}/cctv/get_stream_url/?identifier=YOUR_DEVICE_ID_HERE&brand=Dahua&begin_time=2025-10-29T08:00:00&stop_time=2025-10-29T10:00:00 HTTP/1.1
Authorization: Bearer {{access_token}}


### 10) Get Device Status of a Hikvision CCTV Camera
### Expected: 200 OK with online/offline status of the device
GET {{HOST}}/cctv/get_device_status/?brand=Hikvision
Authorization: Bearer {{access_token}}

### 11) Get Device Status of a Dahua CCTV Camera
### Expected: 200 OK with online/offline status of the device
GET {{HOST}}/cctv/get_device_status/?brand=Dahua&identifier=YOUR_DEVICE_ID_HERE HTTP/1.1
Authorization: Bearer {{access_token}}


### 12) Test Motion Detection Callback (simulating DoLynk push)
### Expected: 200 OK with {"code": "200", "message": "received"}

POST {{HOST}}/integration/motion-callback/ HTTP/1.1
Content-Type: application/json

{
  "eventType": "motionDetect",
  "deviceId": "DAHUA123457",
  "status": "start",
  "timestamp": "2025-10-30T15:20:00Z"
}


#*****************************CCTV managment Endpoints end********************************************/